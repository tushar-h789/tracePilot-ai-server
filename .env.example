# TracePilot AI server — local configuration template.
# Copy to `.env` (gitignored) and replace every `change-me-*` value. Never commit `.env`.
# Use URL-safe characters (letters, digits, - _ .) in passwords because they are embedded in URLs.

# --- Application ---------------------------------------------------------------
# dev | test | prod (prod refuses placeholder credentials)
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- Identity / sessions (Phase 2) -----------------------------------------------
# Signs CSRF tokens. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value-here
# true over HTTPS (adds Secure + __Host- cookie prefix); required when APP_ENV=prod
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
# Argon2id cost (defaults = RFC 9106 low-memory profile)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
# Login / register rate limits (fixed window, Redis)
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_PER_IP=20
REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted (empty = none)
TRUSTED_PROXIES=

# --- Projects / ingestion (Phase 3) ------------------------------------------------
# HMAC pepper for ingestion key hashes (>= 32 chars). Changing it invalidates every ingestion key.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INGEST_KEY_PEPPER=change-me-generate-another-long-random-value
# Optional limits (defaults shown)
# INGEST_MAX_BODY_BYTES=1048576
# INGEST_MAX_BATCH_EVENTS=500
# INGEST_RATE_LIMIT_REQUESTS_PER_KEY=120
# INGEST_RATE_LIMIT_EVENTS_PER_PROJECT=50000
# INGEST_RATE_LIMIT_WINDOW_SECONDS=60
# MAX_ACTIVE_KEYS_PER_PROJECT=10

# --- Postgres (docker compose) -------------------------------------------------
POSTGRES_USER=tracepilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tracepilot

# --- Redis (docker compose) ----------------------------------------------------
REDIS_PASSWORD=change-me-local-only

# --- Connection URLs for tools run on the HOST (uv run alembic / pytest / uvicorn) ---
# Containers get their own URLs (service names) from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://tracepilot:change-me-local-only@127.0.0.1:5433/tracepilot
REDIS_URL=redis://:change-me-local-only@127.0.0.1:6380/0
# Integration tests (database name must end with _test; created on first Postgres start)
TEST_DATABASE_URL=postgresql+psycopg://tracepilot:change-me-local-only@127.0.0.1:5433/tracepilot_test
TEST_REDIS_URL=redis://:change-me-local-only@127.0.0.1:6380/15

# --- Host ports (all bound to 127.0.0.1) ----------------------------------------
API_PORT=8000
WEB_PORT=3100
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- AI (Phase 6; nothing calls it yet) ----------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
